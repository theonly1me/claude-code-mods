{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM"],
    "paths": {
      "claude-code": ["./.claude-types/claude-code/index.d.ts"],
      "claude-code/testing": ["./.claude-types/claude-code/index.d.ts"],
      "claude-code-tools": ["./.claude-types/claude-code-tools/index.d.ts"],
      "claude-code-mcp": ["./.claude-types/claude-code-mcp/index.d.ts"]
    }
  },
  "include": ["shared/**/*.ts", "plugins/**/*.ts", "types/**/*.d.ts"]
}
