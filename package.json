{
  "name": "claude-code-mods",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "node tools/prepare.mjs",
    "validate": "node tools/check.mjs validate",
    "test": "node tools/check.mjs test",
    "typecheck": "tsc --noEmit",
    "storyboard": "node --import ./tools/typescript-loader.mjs tools/storyboard.mjs",
    "previews": "node --import ./tools/typescript-loader.mjs tools/previews.mjs",
    "journal-preview": "node --import ./tools/typescript-loader.mjs tools/journal-preview.ts",
    "sdk-types": "node tools/sdk-types.mjs",
    "smoke:install": "node tools/smoke.mjs install",
    "smoke:model": "node tools/smoke.mjs model --use-local-auth"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
